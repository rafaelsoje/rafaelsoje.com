# Configurações do Servidor SMTP para envio de formulário de contato
# Preencha em .env.local para testes locais ou nas variáveis do ambiente de produção

# Host do servidor SMTP (ex: smtp.provedor.com.br, mail.rafaelsoje.com, smtp.sendgrid.net)
SMTP_HOST=smtp.exemplo.com

# Porta SMTP (geralmente 465 para SSL/TLS ou 587 para STARTTLS)
SMTP_PORT=587

# Indica se a conexão utiliza TLS/SSL seguro diretamente (true para 465, false para 587)
SMTP_SECURE=false

# Usuário de autenticação SMTP
SMTP_USER=contato@rafaelsoje.com

# Senha do usuário de autenticação SMTP (NUNCA versione o valor real)
SMTP_PASS=sua_senha_segura_aqui

# Endereço de remetente (From)
SMTP_FROM="Rafael Soje <contato@rafaelsoje.com>"

# Endereço de destino para recebimento das mensagens
CONTACT_RECIPIENT_EMAIL=contato@rafaelsoje.com

# ID público do portal HubSpot para o Tracking Code global. Sem valor, o script não carrega.
# Use o mesmo portal do formulário configurado em HUBSPOT_PORTAL_ID.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=

# IDs públicos do formulário existente na HubSpot Forms API (server-side).
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# Cloudflare Turnstile (Proteção Anti-Spam e Anti-Bot)
# Chave pública para renderização do widget Turnstile no navegador
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Chave secreta SOMENTE server-side para validação da submissão na API da Cloudflare
TURNSTILE_SECRET_KEY=
TURNSTILE_SECRET=

# Hostnames autorizados para verificação canônica (separados por vírgula)
TURNSTILE_HOSTNAMES=rafaelsoje.com,localhost,127.0.0.1
